function Core.collectionAudit(s,data,cfg)
if type(cfg.collectionBonus)~='function' then return nil,'Native collection formula unavailable' end
for _,key in ipairs({'inventory','inventoryBound','collection','collectionBound'}) do
if type(s[key])~='table' then return nil,'Waiting for inventory and collection state' end
end
local rows={}
for id,item in pairs(data.ITEMS_BY_ID or {}) do
if type(item)=='table' and (item.kind=='background' or item.kind=='border') and not item.rankOnly then
local loose=num(s.inventory[id])+num(s.inventoryBound[id])
local deposited=num(s.collection[id])+num(s.collectionBound[id])
if loose+deposited>0 then
local equipped=(item.kind=='background' and s.equippedBackground or s.equippedBorder)==id
local protected=equipped and 1 or 0
local surplus=math.max(0,num(s.inventory[id])-protected)
local before=cfg.collectionBonus(item.rarity,deposited)
local after=cfg.collectionBonus(item.rarity,deposited+surplus)
rows[#rows+1]={id=id,name=item.name or id,kind=item.kind,loose=loose,deposited=deposited,
protected=protected,surplus=surplus,gain=num(after)-num(before)}
end
end
end
table.sort(rows,function(a,b)
if a.gain~=b.gain then return a.gain>b.gain end
return a.id<b.id
end)
return rows
end
function Core.cosmeticPlan(s,data,cfg,objective)
