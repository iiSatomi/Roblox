end
local function bossBetter(a,b,mode)
if not b then return true end
if mode=='Progression' then
if a.undefeated~=b.undefeated then return a.undefeated end
return a.order<b.order
end
if mode=='Best chest' then
if a.crateRarity~=b.crateRarity then return a.crateRarity>b.crateRarity end
if a.firstRarity~=b.firstRarity then return a.firstRarity>b.firstRarity end
if a.bonusRarity~=b.bonusRarity then return a.bonusRarity>b.bonusRarity end
if a.bonusChance~=b.bonusChance then return a.bonusChance>b.bonusChance end
elseif mode=='Cash reward' then
if a.cash~=b.cash then return a.cash>b.cash end
elseif mode=='XP reward' then
if a.xp~=b.xp then return a.xp>b.xp end
elseif mode=='Highest level' then
if a.level~=b.level then return a.level>b.level end
else
if a.undefeated~=b.undefeated then return a.undefeated end
if a.undefeated and a.order~=b.order then return a.order<b.order end
if a.crateRarity~=b.crateRarity then return a.crateRarity>b.crateRarity end
if a.firstRarity~=b.firstRarity then return a.firstRarity>b.firstRarity end
end
if a.level~=b.level then return a.level>b.level end
if a.cash~=b.cash then return a.cash>b.cash end
if a.xp~=b.xp then return a.xp>b.xp end
return a.order<b.order
end
