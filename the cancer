end
local now=workspace:GetServerTimeNow()
local stock,expires,slot=shopUtil.shopStock(data,now)
local prices,goldPrices={},{}
for _,row in ipairs(data.SHOP or {}) do
if row.goldPrice==nil then
local price=shopUtil.shopPrice(row,slot)
local global=mw.GetAttribute and tonumber(mw:GetAttribute('GlobalShopDiscount')) or 0
global=(global and global>0 and global<1) and global or 0
local territory=shopRules and shopRules.fromData(s,'shopDiscount') or 0
local discount=1-(1-global)*(1-territory)
if discount>0 then
