local function advanceHeist(p,now,s)
if p.timedOut and not p.settled then
if skipUnconfirmed(p,now) then return end
if p.sent and not p.sendInFlight and not ctl.EmergencyStopped then
local request=Heists.reconcile(p.heist,now)
if request then
logEvent('heist_reconcile_read',{feature=p.action.feature,attempt=p.heist.reconcileAttempts})
sendPending(p,request)
elseif p.heist.reconcileAttempts>=6 and not p.heist.inFlight
and not p.heist.reconcileSlowLogged then
p.heist.reconcileSlowLogged=true
status='Paused: '..p.action.details..' is unconfirmed after 6 read-only checks; continuing slow read-only checks every 5 minutes. No mutation will be replayed.'
logEvent('heist_reconcile_slow',{feature=p.action.feature,attempts=p.heist.reconcileAttempts})
end
