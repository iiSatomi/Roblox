end
if p.action.remote=='DeleteProperty' or p.action.remote=='BuyProperty' then
ctl.SavePropertyReview(true,p.action)
ctl.Blocked.properties='Property action unconfirmed after 45 seconds. Review ownership and cash, then resume Auto buy properties.'
if p.action.remote=='DeleteProperty' then propertyReplacePlan=nil end
logEvent('property_action_paused',{remote=p.action.remote,target=p.action.args[1],replacement=p.action.replacementId})
end
if key=='heists' or key=='heistCollect' or key=='favors' or key=='sabotage' then
if key=='sabotage' and p.action.heistKind=='sabotage' then
heistView.sabotageUncertain[tostring(p.action.args[2])]=true end
for _,shared in ipairs({'heists','heistCollect','favors','sabotage'}) do
ctl.RetryAt[shared]=math.max(ctl.RetryAt[shared] or 0,now+delay)
ctl.RetryReason[shared]='Unconfirmed heist action skipped'
end
heistView.board=nil;heistView.at=-math.huge
end
if key=='familyBossClaims' or key=='familyBossAttacks' then familyBossView.at=nil end
if key=='residency' then ctl.ResidencyView.views={};ctl.ResidencyView.preflightId=nil end
if key=='station' then ctl.ResidencyView.mapAt=nil;ctl.ResidencyView.stationDetails={} end
nextActionAt=now
status='Unconfirmed after 45s: '..p.action.details..'. Original action may have succeeded; skipping it and retrying '
..(featureLabels[key] or key)..' in '..delay..'s. Other routines continue.'
failureLog('unconfirmed_skipped',{feature=key,remote=p.action.remote,args=p.action.args,
before=p.before,after=observed,response=p.response,settled=p.settled,
seconds=45,retrySeconds=delay,duplicateRisk=true})
return true
end
