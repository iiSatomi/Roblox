function Core.progressionFairPick(candidates,order,cursor,credits,preset,included)
local boosts=({Smart={jobs=2,properties=2},Money={jobs=2,properties=3},XP={jobs=3}})[preset] or {}
local best,bestIndex,bestCredit,bestWeight,total=nil,nil,nil,1,0
for offset=1,#order do
local index=(num(cursor)+offset-1)%#order+1
local key=order[index]
local candidate=tab(candidates)[key]
if type(candidate)=='table' then
local weight=(included==nil or tab(included)[key]==true) and (boosts[key] or 1) or 1
local credit=math.max(-64,math.min(64,num(credits[key])))+weight
credits[key]=credit;total=total+weight
if bestCredit==nil or credit>bestCredit then
best,bestIndex,bestCredit,bestWeight=candidate,index,credit,weight
end
else credits[key]=nil end
end
if not best then return nil,cursor,'No eligible activity' end
credits[order[bestIndex]]=math.max(-64,bestCredit-total)
return best,bestIndex,string.format('%s goal-weighted fair rotation: %s has weight %d of %d ready',
    tostring(preset or 'Balanced'),tostring(order[bestIndex]),bestWeight,total)
end
