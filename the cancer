end
if skipUnconfirmed(p,now) then return end
if p.timedOut then return end
if outcome=='uncertain' or p.heist.terminal=='uncertain' or now-p.started>=120
or (p.sendInFlight and p.lastSent and now-p.lastSent>=settings.timeout) then
