for _,kind in ipairs({'background','border'}) do
local rows={};local current=s[kind=='background' and 'equippedBackground' or 'equippedBorder']
local pool,baseline=0,0
for _,row in ipairs(audit) do
if row.kind==kind then
local item=data.ITEMS_BY_ID[row.id]
if type(item.atk)~='number' or type(item.def)~='number' then return nil,'Cosmetic stats unavailable for '..row.id end
row.item=item
row.boundLoose=num(s.inventoryBound[row.id])
row.unbound=num(s.inventory[row.id])+num(s.collection[row.id])
row.total=row.unbound+num(s.collectionBound[row.id])
pool=pool+cfg.collectionBonus(item.rarity,row.total)
baseline=baseline+cfg.collectionBonus(item.rarity,row.deposited)
rows[#rows+1]=row
end
end
local function score(a,d)
return objective=='Attack' and a*atkMult or objective=='Defense' and d*defMult or a*atkMult+d*defMult
end
if current then
local found=false;for _,row in ipairs(rows) do if row.id==current then found=true end end
if not found then return nil,'Equipped '..kind..' is outside the verified comparison catalog' end
end
local currentItem=tab(tab(data.ITEMS_BY_ID)[current])
local baseAtk=baseline+num(currentItem.atk);local baseDef=baseline+num(currentItem.def)
local best={id=false,name='None (collect all)',atk=pool,def=pool,score=score(pool,pool)}
for _,row in ipairs(rows) do
if row.unbound+row.boundLoose>0 then
local item=row.item
local useBound=row.boundLoose>0
local loss=useBound and 0 or cfg.collectionBonus(item.rarity,row.total)-cfg.collectionBonus(item.rarity,row.total-1)
local atk,def=pool-loss+item.atk,pool-loss+item.def
local value=score(atk,def)
if value>best.score or (value==best.score and row.id==current) then
best={id=row.id,name=item.name or row.id,atk=atk,def=def,score=value,
withdrawalNeeded=not useBound and num(s.inventory[row.id])<1,collectionLoss=loss,useBound=useBound}
end
end
end
best.gainAtk=best.atk-baseAtk;best.gainDef=best.def-baseDef
best.collect={}
for _,row in ipairs(rows) do
best.collect[row.id]=row.total-(best.id==row.id and not best.useBound and 1 or 0)
end
result[kind]=best
end
return result
end
