local bypassed=false
if p.settled then
local response=p.response
local phase=p.heist.phase
local bypassResponse=settings.skipConfirmation and phase=='mutation' and p.ok and p.action.heistKind~='sabotage'
and type(response)=='table' and response.ok==true and response.pending~=true and response.code~='rate_limited'
outcome=Heists.receive(p.heist,p.ok,response,now,heistView,s)
if bypassResponse and outcome=='wait' and p.action.heistKind~='board' then
p.heist.terminal='confirmed'
outcome='confirmed'
bypassed=true
heistView.at=-math.huge -- Force a fresh board read before planning another heist/favor action.
logEvent('confirmation_bypassed',{feature=p.action.feature,remote=p.action.remote,kind=p.action.heistKind,
reason='successful mutation response',interval=settings.interval})
end
p.settled=false;p.sendInFlight=false
end
if outcome=='confirmed' or outcome=='read' then
if outcome=='confirmed' then
if bypassed then ctl.Bypassed=ctl.Bypassed+1 else ctl.Confirmed=ctl.Confirmed+1 end
ctl.Spent=ctl.Spent+p.action.cost
contractControl.observe(p.contractRefs,s,now)
if p.action.feature=='favors' then
local day=math.floor(Core.num(heistView.board and heistView.board.serverNow)/86400)
if settings.favorUsageDay~=day then settings.favorUsageDay=day;settings.favorUsageCount=0 end
settings.favorUsageCount=Core.num(settings.favorUsageCount)+1
settings=Core.settings(settings);save()
logEvent('favor_confirmed',{rowId=p.action.args[2],owner=p.action.ownerName,
cash=p.action.rewardCash,xp=p.action.rewardXp,day=day,count=settings.favorUsageCount})
end
if p.action.feature=='sabotage' then
local day=math.floor(Core.num(heistView.board and heistView.board.serverNow)/86400)
if settings.sabotageUsageDay~=day then settings.sabotageUsageDay=day;settings.sabotageUsageCount=0 end
settings.sabotageUsageCount=Core.num(settings.sabotageUsageCount)+1
settings=Core.settings(settings);save()
logEvent('sabotage_confirmed',{rowId=p.action.args[2],owner=p.action.ownerName,day=day,count=settings.sabotageUsageCount})
end
end
ctl.Pending=nil;ctl.Failures[p.action.feature]=0;nextActionAt=afterConfirmedRequest(p,now)
status=outcome=='read' and (p.action.feature=='favors' and 'Heist board refreshed for Favor help' or 'Personal heist board refreshed')
or (bypassed and ('Response accepted (testing bypass): '..p.action.details) or ('Observed heist confirmation: '..p.action.details))
return
end
if outcome=='rejected' then
local key=p.action.feature
ctl.Failures[key]=(ctl.Failures[key] or 0)+1
local delay=math.max(settings.interval,15,math.min(300,2^math.min(9,ctl.Failures[key])))
for _,shared in ipairs({'heists','heistCollect','favors','sabotage'}) do
ctl.RetryAt[shared]=math.max(Core.num(ctl.RetryAt[shared]),now+delay)
ctl.RetryReason[shared]='Heist request rejected'
end
heistView.board=nil;heistView.at=-math.huge
nextActionAt=now;ctl.Pending=nil
status=(p.heist.reason or 'Heist board request failed')..'; retrying in '..delay..'s while other routines continue'
logEvent('heist_rejected_retry',{feature=key,remote=p.action.remote,attempts=ctl.Failures[key],retrySeconds=delay,reason=p.heist.reason})
