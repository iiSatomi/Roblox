elseif a.remote=='FamilyBossAction' and FamilyBoss then before=FamilyBoss.mark(a,s,familyBossView.data,player.UserId)
else before=Core.mark(a,s) end
local pending={action=a,remote=remote,before=before,started=os.clock(),settled=false}
if settings.autoContracts and Contracts then pending.contractRefs=Contracts.match(contractControl.view,a) end
if a.remote=='BossAction' and pending.before.hp==nil then
