local function timeoutPending(p,now,event,details)
if p.timedOut or ctl.Pending~=p then return end
local a=p.action
local combatRequest=a.feature=='combat' or a.feature=='warCombat'
if a.readOnly or a.familyRead or a.heistKind=='board' then
local key=a.feature
ctl.Failures[key]=(ctl.Failures[key] or 0)+1
ctl.Pending=nil
if a.remote=='PlayerProfile' and combatView.profiles.inFlight then
combatView.profiles.inFlight[tostring(math.floor(Core.num(a.args[1])))]=nil
end
local delay=combatRequest and math.max(settings.interval,2) or math.max(settings.interval,15,math.min(300,2^ctl.Failures[key]))
ctl.RetryAt[key]=math.max(Core.num(ctl.RetryAt[key]),now+delay)
ctl.RetryReason[key]='Read timed out'
if a.heistKind=='board' then
for _,shared in ipairs({'heists','heistCollect','favors','sabotage'}) do
ctl.RetryAt[shared]=math.max(Core.num(ctl.RetryAt[shared]),now+delay)
ctl.RetryReason[shared]='Heist board read timed out'
end
end
if a.familyBossRead then
for _,shared in ipairs({'familyBossClaims','familyBossAttacks'}) do
ctl.RetryAt[shared]=math.max(Core.num(ctl.RetryAt[shared]),now+delay)
ctl.RetryReason[shared]='Takedown state read timed out'
end
end
nextActionAt=now
if combatRequest then
ctl.Quarantined=ctl.Quarantined+1
ctl.RetryAt[a.feature]=math.max(Core.num(ctl.RetryAt[a.feature]),now+delay)
status='Combat read timed out: '..a.details..'. Quarantined; other routines continue.'
else
status='Read timed out: '..a.details..'. Other routines continue after backoff.'
end
elseif combatRequest and (a.remote=='ScoutPlayer' or a.remote=='Attack') and p.sent then
p.timedOut=true
ctl.Quarantined=ctl.Quarantined+1
status='Combat request timed out without a usable confirmation: '..a.details..'. Watching for proof until the 45-second skip deadline.'
else
p.timedOut=true
status='Paused on uncertain action: '..a.details..'. Rechecking replicated state; no new action until its outcome is proven.'
end
failureLog(event,details)
end
local function skipUnconfirmed(p,now,observed)
if ctl.Pending~=p or not p.sent or not p.firstSentAt or now-p.firstSentAt<45 then return false end
local key=p.action.feature
ctl.Pending=nil
ctl.Skipped=ctl.Skipped+1
ctl.Failures[key]=(ctl.Failures[key] or 0)+1
local delay=math.min(300,45*2^math.min(3,ctl.Failures[key]-1))
ctl.RetryAt[key]=now+delay
ctl.RetryReason[key]='Unconfirmed action skipped'
if p.journalId then Journal.finish(ctl.ActionJournal,p.journalId,'unconfirmed',now,now+delay);ctl.SaveJournal() end
ctl.SkippedByFeature[key]={action=p.action,before=p.before,journalId=p.journalId,retryAt=now+delay}
if p.action.marketFlipKind then
ctl.MarketFlip.markReview('Market '..p.action.marketFlipKind..' unconfirmed after 45 seconds; inspect Gold, inventory, and owned listings before another flip')
end
if p.action.gearPlanStep then
