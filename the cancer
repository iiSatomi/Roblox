function ctl.RefreshProfileOverview()
local root='IdleMafiaFluent/'..tostring(game.PlaceId)
local accounts={[player.Name]=true}
local discover=''
if type(listfiles)=='function' then
local ok,entries=pcall(listfiles,root)
if ok and type(entries)=='table' then
for i=1,math.min(#entries,200) do
local path=type(entries[i])=='string' and entries[i]:gsub('\\','/') or ''
local prefix=root..'/'
if path:sub(1,#prefix)==prefix then
local child=path:sub(#prefix+1)
local name=child:match('^([%w_]+)/*$') or child:match('^([%w_]+)/configs%.json$')
if name and #name<=20 then accounts[name]=true end
end
end
else discover='Account discovery unavailable: listfiles failed.\n' end
else discover='Account discovery unavailable: listfiles is not supported.\n' end
local names={};for name in pairs(accounts) do if name~=player.Name then names[#names+1]=name end end
table.sort(names)
table.insert(names,1,player.Name)
local rows={discover}
local shown=0
for _,name in ipairs(names) do
if shown>=25 then rows[#rows+1]='…more accounts omitted';break end
shown=shown+1
local data=name==player.Name and configs or nil
if not data then
local file=root..'/'..name..'/configs.json'
local exists,fileFound=pcall(function() return type(isfile)=='function' and isfile(file) end)
if exists and fileFound then
local ok,value=pcall(function() return Http:JSONDecode(readfile(file)) end)
if ok and type(value)=='table' and value.version==1 and type(value.profiles)=='table' then data=value end
end
end
if data then
local count=0
for key,profile in pairs(data.profiles) do
if configName(key) and type(profile)=='table' then count=count+1 end
end
local autoload=configName(data.autoload) and type(data.profiles[data.autoload])=='table' and data.autoload or 'Off'
rows[#rows+1]=name..' → '..autoload..' autoload · '..count..' saved'
else rows[#rows+1]=name..' → unavailable' end
end
local display=table.concat(rows,'\n')
ctl.SetDisplay(accountOverview,display,'account autoload overview')
return display
end
