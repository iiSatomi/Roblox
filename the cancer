end
function Core.trophyFocus(s,data,cfg,settings,optIns)
settings=tab(settings)
optIns=tab(optIns)
local result={goalId=settings.trophyGoalId,status='off',borrow={}}
if settings.trophyFocus~=true then result.reason='Trophy Focus is off';return result end
if type(settings.trophyGoalId)~='string' or settings.trophyGoalId=='' then
result.status='waiting';result.reason='Choose a trophy goal';return result end
local view,why=Core.trophyHunter(s,data,cfg)
if not view then result.status='waiting';result.reason=why;return result end
local row=view.byId[settings.trophyGoalId]
if not row then result.status='blocked';result.reason='Selected trophy is not in the current native catalog';return result end
result.name=row.name
result.route=row.route
if row.status=='owned' then
result.status='owned';result.reason='Trophy already owned';return result
end
if row.route=='trade-in' then
result.status='blocked';result.reason='Item-consuming trade-in is manual; Trophy Focus will not submit it';return result
end
if row.status=='ready' then
result.status='working';result.borrow.trophies=true
result.reason='Native reward ready; claiming the selected non-consuming trophy'
return result
end
if row.status=='waiting for native readiness' then
result.status='waiting';result.reason='Goal appears reached; waiting for native trophy readiness';return result end
if row.status=='eligibility unknown' then
result.status='waiting';result.reason='Native trophy readiness unavailable';return result end
if row.route=='level' then
if type(s.level)~='number' then result.status='waiting';result.reason='Level state unavailable';return result end
result.borrow.jobs=true;result.jobMode='XP / energy'
elseif row.route=='mastery' then
if not trophyJobCities[row.id] then result.status='blocked';result.reason='No verified city for this mastery trophy';return result end
if not row.progress or row.progress:find('unavailable',1,true) then
result.status='waiting';result.reason=row.progress or 'Job mastery state unavailable';return result end
result.borrow.jobs=true;result.jobMode='Mastery';result.jobCity=trophyJobCities[row.id]
elseif row.id=='t_deedbook' then
if type(s.properties)~='table' then result.status='waiting';result.reason='Property ownership state unavailable';return result end
result.borrow.properties=true
elseif row.id=='t_brasskeys' then
if type(s.properties)~='table' then result.status='waiting';result.reason='Property ownership state unavailable';return result end
local ashport=tab(tab(data.CITY_PROPERTIES).city_ashport)
if #ashport==0 then result.status='waiting';result.reason='Native Ashport Property list unavailable';return result end
result.propertyIds={}
for _,id in ipairs(ashport) do
if owned(s,id)==0 and Core.activityAllowed(settings,'properties',id) then result.propertyIds[id]=true end
end
if next(result.propertyIds)==nil then
result.status='blocked';result.reason='No missing Ashport Property is allowed by the current Property selection';return result
end
result.borrow.properties=true
result.propertyReplace=false
elseif row.id=='t_manifest' then
result.borrow.operations=true;result.borrow.collect=true
result.operationMode='Shortest duration'
elseif row.route=='respect' then
if not optIns.combat or not optIns.combatArmed then
result.status='blocked';result.reason='Winning player fights earns Respect; enable Combat and this session\'s player-combat permission';return result
end
result.priority='combat'
elseif row.id=='t_vaultdial' then
result.borrow.bank=true
elseif row.id=='t_firstscore' or row.id=='t_mastermind' or row.id=='t_cleangetaway' then
result.borrow.heists=true;result.borrow.heistCollect=true
elseif row.id=='t_wrench' then
if settings.sabotageEnabled then result.borrow.sabotage=true
else result.status='blocked';result.reason='Heist sabotage needs its separate Auto Sabotage switch';return result end
elseif row.id=='t_accomplice' then
if not optIns.favors then result.status='blocked';result.reason='Enable Auto help active heists in Favors for this player-facing trophy';return result end
result.priority='favors'
elseif row.id=='t_knucklecast' or row.id=='t_brokenblade' then
if not optIns.combat or not optIns.combatArmed then
result.status='blocked';result.reason='Enable Mug players and this session\'s player-combat permission for win trophies';return result
end
result.priority='combat'
elseif trophyHauls[row.id] then
local crateId=trophyHauls[row.id]
if not optIns.chests then
result.status='blocked';result.reason='Enable Auto open all chests separately to open a matching Takedown Haul';return result
end
if tab(tab(data.ITEMS_BY_ID)[crateId]).kind~='crate' then
result.status='waiting';result.reason='Matching native Takedown Haul crate unavailable';return result
end
if num(tab(s.inventory)[crateId])<1 then
result.status='waiting';result.reason='Waiting for an unbound matching Takedown Haul crate; a trophy drop is not guaranteed';return result
end
result.priority='chests';result.chestId=crateId
result.reason='Opening the matching owned Haul via separately enabled Auto chests; trophy drop is chance-based'
elseif row.id=='t_doorpanel' then
result.status='blocked';result.reason='Defense wins depend on incoming attacks; no verified personal action can force this trophy';return result
elseif row.route=='family' then
result.status='blocked';result.reason='This is a shared Family outcome, not a verified personal Trophy Focus action';return result
elseif row.route=='shop rotation' then
result.status='blocked';result.reason='This Gold purchase needs a separate Shop opt-in and a live-confirmed purchase contract';return result
elseif row.route=='bundle' then
result.status='blocked';result.reason='Bundle acquisition has no verified personal Trophy Focus action';return result
else
result.status='blocked'
result.reason='No verified personal automation for this trophy route'
return result
end
result.status='working'
result.reason=result.reason or result.priority and ('Using separately enabled '..(result.priority=='favors' and 'Favor help' or 'Combat')..' within its current limits')
or 'Using existing personal routines within their current limits'
return result
end
