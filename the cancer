if exact then combatSearch.byId[id]={at=serverNow,target=exact} end
ctl.Failures[a.feature]=0
logEvent(late and 'combat_late_search' or 'combat_search',{name=a.args[1],expectedId=a.lookupUserId,matched=exact~=nil,resultCount=#response.list})
return true
elseif a.remote=='PlayerProfile' then
local id=tostring(math.floor(Core.num(a.args[1])))
local profileOk,profile=xpcall(function()
return Combat and Combat.publicProfile(response,serverNow,data) or nil
end,function(err) return debug.traceback(tostring(err),2) end)
