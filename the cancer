local LoadFluent=(function()
return function()
local url='https://github.com/ActualMasterOogway/Fluent-Renewed/releases/download/v1.0.8/Fluent.luau'
assert(type(loadstring)=='function','Fluent loader requires loadstring support')
local downloaded,source=pcall(function() return game:HttpGetAsync(url) end)
assert(downloaded and type(source)=='string','Fluent download failed: '..tostring(source))
local chunk,compileError=loadstring(source)
assert(chunk,'Fluent compilation failed: '..tostring(compileError))
local ok,library=pcall(chunk)
assert(ok,'Fluent initialization failed: '..tostring(library))
assert(type(library)=='table' and type(library.CreateWindow)=='function' and type(library.Destroy)=='function',
    'Fluent returned an incompatible library')
return library
end
end)()
local Bootstrap=(function()
return function(Start,LoadFluent,Core,Heists,Combat,Family,FamilyBoss,Residency,Journal,hubVersion,Contracts,Market)
if type(Core)=='table' then Core.Market=Market end
local function launch(fluent)
local ok,ctl=pcall(Start,Core,fluent,Heists,Combat,Family,FamilyBoss,Residency,Journal,hubVersion,Contracts)
if not ok or type(ctl)~='table' then
pcall(function() fluent:Destroy() end)
return false,tostring(ctl)
end
ctl.RestartWithConfig=function(name)
local prepared,nextFluent=pcall(LoadFluent)
if not prepared then return false,'Fluent could not load: '..tostring(nextFluent) end
local selected,reason=ctl.LoadConfig(name)
if not selected then
pcall(function() nextFluent:Destroy() end)
return false,reason
end
local unloaded,unloadError=pcall(function() ctl.Unload() end)
if not unloaded or ctl.Running then
pcall(function() nextFluent:Destroy() end)
return false,'Existing hub could not unload: '..tostring(unloadError)
end
local started,nextCtl=launch(nextFluent)
if not started then
if type(warn)=='function' then pcall(warn,'[Idle Mafia] Profile reload failed after unload: '..tostring(nextCtl)) end
return false,nextCtl
end
return true,nextCtl
end
return true,ctl
end
local prepared,fluent=pcall(LoadFluent)
if not prepared then error(fluent) end
local started,ctl=launch(fluent)
if not started then error(ctl) end
return ctl
end
end)()
return Bootstrap(Start,LoadFluent,Core,Heists,Combat,Family,FamilyBoss,Residency,Journal,'0.48.17',Contracts,Market)
