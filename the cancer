warCount=(function() local n=0;for _ in pairs(cache.warById or {}) do n=n+1 end;return n end)()})
return true
elseif a.remote=='SearchTarget' then
local id=tostring(a.lookupUserId or '')
local cache=Combat and Combat.targets(response,serverNow) or nil
if not cache then return false end
local exact=cache.byId[id]
combatSearch.lastAt=serverNow
