view.total=view.total+1;view.rows[#view.rows+1]=row;view.byId[row.id]=row
end
end
table.sort(view.rows,function(a,b) return a.name<b.name end)
table.sort(view.quick,function(a,b) return a.name<b.name end)
table.sort(view.near,function(a,b) return a.name<b.name end)
