if complete then row.status='waiting for native readiness'
elseif near then view.near[#view.near+1]=row end
end
elseif route.kind=='respect' and type(s.respect)=='number' then
row.progress=tostring(math.floor(s.respect))..'/'..tostring(route.goal)..' respect'
if row.status=='not ready' then
local remaining=math.max(0,route.goal-s.respect)
if remaining==0 then row.status='waiting for native readiness'
elseif remaining<=math.floor(route.goal*0.1) then view.near[#view.near+1]=row end
end
elseif trophyHauls[item.id] then
local crateId=trophyHauls[item.id]
if tab(tab(data.ITEMS_BY_ID)[crateId]).kind=='crate' then
row.progress=tostring(math.floor(num(s.inventory[crateId])))..' matching unbound Haul crates in inventory; drop is chance-based'
else row.progress='Matching native Haul crate unavailable' end
