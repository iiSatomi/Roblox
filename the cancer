local function shopQuote(s)
local ok,q=pcall(function()
if not shopUtil then
local module=mw:FindFirstChild('Util')
if not module then return nil end
shopUtil=require(module)
end
if not shopRules then
local module=mw:FindFirstChild('TerritoryBonusRules')
